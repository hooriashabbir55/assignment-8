
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Latest News</title>
  <style>
    /* General Page Styling */
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f9f9f9;
      color: #333;
      margin: 40px;
      line-height: 1.6;
    }

    /* Main Heading */
    h1 {
      text-align: center;
      color: #066cd3;
      text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
    }

    /* Paragraph Styling */
    p {
      text-align: justify;
      font-size: 18px;
      margin-bottom: 20px;
    }

    /* ::first-letter */
    p::first-letter {
      font-size: 200%;
      font-weight: bold;
      color: #d10a67;
    }

    /* ::first-line */
    p::first-line {
      font-style: italic;
      color: #00796b;
    }

    /* Link Styling */
    a:link {
      color: blue;
      text-decoration: none;
    }

    a:visited {
      color: purple;
    }

    a:hover {
      color: orange;
      text-decoration: underline;
    }

    a:focus {
      background-color: yellow;
      outline: 2px solid orange;
    }

    /* Footer */
    footer {
      text-align: center;
      margin-top: 40px;
      padding-top: 10px;
      border-top: 2px solid #ccc;
      color: #555;
      font-style: italic;
    }
  </style>
</head>
<body>
